{
    "nodes": {
        "dlss": {
            "enabled": true,
            "outputs": [
                "out->exposure.src",
                "out->ui.extent_ref"
            ],
            "properties": {
                "mode": "ray reconstruction"
            },
            "type": "DLSS"
        },
        "gbuffer": {
            "$+$outputs": [
                "gbuffer->dlss.gbuffer"
            ],
            "properties": {
                "max roughness": 0.4,
                "primary surface replacement": true,
                "texture lod bias": -1.0
            }
        },
        "quake": {
            "$+$outputs": [
                "scene->dlss.scene"
            ],
            "properties": {
                "enable transparency": true
            }
        },
        "render": {
            "properties": {
                "output": {
                    "demodulate albedo": false
                }
            }
        },
        "tonemap": {
            "outputs": [
                "out->composite.input_0"
            ]
        }
    }
}
