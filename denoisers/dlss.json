{
    "cli": {
        "volume": {
            "default": "off",
            "type": "variant",
            "variants": {
                "off": {
                    "merge": "denoisers/dlss_irradiance.json"
                },
                "on": {
                    "merge": [
                        "renderers/volume.json",
                        "renderers/mcpg_volume.json",
                        "denoisers/dlss_volume.json"
                    ]
                }
            }
        },
        "quality": {
            "default": "default",
            "type": "variant",
            "variants": {
                "default": {
                    "set": {
                        "/nodes/gbuffer/properties/resolution scale": "3/4",
                        "/nodes/render/properties/surface/nee sampling": "resampled (RIS)",
                        "/nodes/render/properties/surface/samples per pixel": 1,
                        "/nodes/render/properties/surface/shares/bsdf": 0.25,
                        "/nodes/render/properties/surface/shares/guiding": 0.75
                    }
                },
                "fast": {
                    "set": {
                        "/nodes/gbuffer/properties/resolution scale": "3/4",
                        "/nodes/render/properties/surface/nee sampling": "mixture (MIS)",
                        "/nodes/render/properties/surface/samples per pixel": 1,
                        "/nodes/render/properties/surface/shares/bsdf": 0.125,
                        "/nodes/render/properties/surface/shares/guiding": 0.375,
                        "/nodes/render/properties/surface/shares/nee": 0.5
                    }
                },
                "quality": {
                    "set": {
                        "/nodes/render/properties/surface/nee sampling": "resampled (RIS)",
                        "/nodes/render/properties/surface/samples per pixel": 1,
                        "/nodes/render/properties/surface/shares/bsdf": 0.25,
                        "/nodes/render/properties/surface/shares/guiding": 0.75
                    }
                },
                "ultra_fast": {
                    "set": {
                        "/nodes/gbuffer/properties/resolution scale": "1/2",
                        "/nodes/render/properties/surface/cache tail": true,
                        "/nodes/render/properties/surface/max diffuse bounces": 1,
                        "/nodes/render/properties/surface/nee sampling": "mixture (MIS)",
                        "/nodes/render/properties/surface/samples per pixel": 1,
                        "/nodes/render/properties/surface/shares/bsdf": 0.125,
                        "/nodes/render/properties/surface/shares/guiding": 0.375,
                        "/nodes/render/properties/surface/shares/nee": 0.5
                    }
                },
                "ultra_quality": {
                    "set": {
                        "/nodes/render/properties/surface/nee sampling": "resampled (RIS)",
                        "/nodes/render/properties/surface/samples per pixel": 2,
                        "/nodes/render/properties/surface/shares/bsdf": 0.25,
                        "/nodes/render/properties/surface/shares/guiding": 0.75
                    }
                }
            }
        }
    },
    "nodes": {
        "dlss": {
            "enabled": true,
            "outputs": [
                "out->exposure.src",
                "out->ui.extent_ref"
            ],
            "properties": {
                "mode": "ray reconstruction"
            },
            "type": "DLSS"
        },
        "gbuffer": {
            "$+$outputs": [
                "gbuffer->dlss.gbuffer"
            ],
            "properties": {
                "max roughness": 0.4,
                "primary surface replacement": true,
                "texture lod bias": -1.0
            }
        },
        "quake": {
            "$+$outputs": [
                "scene->dlss.scene"
            ],
            "properties": {
                "enable transparency": true
            }
        },
        "render": {
            "properties": {
                "output": {
                    "demodulate albedo": false
                }
            }
        },
        "tonemap": {
            "outputs": [
                "out->composite.input_0"
            ]
        }
    }
}
