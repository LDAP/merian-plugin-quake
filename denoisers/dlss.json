{
    "cli": {
        "volume": {
            "default": "off",
            "type": "variant",
            "variants": {
                "off": {},
                "on": {
                    "merge": [
                        "renderers/volume.json",
                        "renderers/mcpg_volume.json",
                        "denoisers/dlss_volume.json"
                    ]
                }
            }
        },
        "quality": {
            "default": "default",
            "type": "variant",
            "variants": {
                "default": {},
                "fast": {
                    "set": {
                        "/nodes/gbuffer/properties/resolution scale": "3/4"
                    }
                },
                "quality": {
                    "set": {
                        "/nodes/render/properties/surface/nee": "resampled (RIS)"
                    }
                },
                "ultra_fast": {
                    "set": {
                        "/nodes/gbuffer/properties/resolution scale": "1/2",
                        "/nodes/render/properties/surface/cache tail": true,
                        "/nodes/render/properties/surface/max diffuse bounces": 1,
                        "/nodes/render/properties/surface/samples per pixel": 1
                    }
                }
            }
        }
    },
    "nodes": {
        "add": {
            "outputs": [
                "out->dlss.src"
            ]
        },
        "dlss": {
            "enabled": true,
            "outputs": [
                "out->exposure.src",
                "out->ui.extent_ref"
            ],
            "properties": {
                "mode": "ray reconstruction"
            },
            "type": "DLSS"
        },
        "gbuffer": {
            "$+$outputs": [
                "gbuffer->dlss.gbuffer"
            ],
            "properties": {
                "max roughness": 0.4,
                "primary surface replacement": true,
                "texture lod bias": -1.0
            }
        },
        "quake": {
            "$+$outputs": [
                "scene->dlss.scene"
            ],
            "properties": {
                "enable transparency": true
            }
        },
        "render": {
            "$+$outputs": [
                "irradiance->add.input_0"
            ],
            "properties": {
                "output": {
                    "demodulate albedo": false
                }
            }
        },
        "tonemap": {
            "outputs": [
                "out->composite.input_0"
            ]
        }
    }
}
