{
    "cli": {
        "volume": {
            "default": "off",
            "type": "variant",
            "variants": {
                "off": {},
                "on": {
                    "merge": [
                        "renderers/volume.json",
                        "renderers/mcpg_volume.json",
                        "denoisers/dlss_volume.json"
                    ]
                }
            }
        }
    },
    "nodes": {
        "add": {
            "outputs": [
                "out->dlss.src"
            ]
        },
        "dlss": {
            "enabled": true,
            "outputs": [
                "out->exposure.src",
                "out->ui.extent_ref"
            ],
            "properties": {
                "mode": "ray reconstruction"
            },
            "type": "DLSS"
        },
        "gbuffer": {
            "$+$outputs": [
                "gbuffer->dlss.gbuffer"
            ],
            "properties": {
                "texture lod bias": -1.0
            }
        },
        "quake": {
            "$+$outputs": [
                "scene->dlss.scene"
            ]
        },
        "render": {
            "$+$outputs": [
                "irradiance->add.input_0",
                "specular_hit_distance->dlss.specular_hit_distance"
            ],
            "properties": {
                "demodulate albedo": false
            }
        },
        "tonemap": {
            "outputs": [
                "out->composite.input_0"
            ]
        }
    }
}
