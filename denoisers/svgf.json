{
    "nodes": {
        "accumulate": {
            "enabled": true,
            "outputs": [
                "history->accumulate.prev_history",
                "history->svgf.history",
                "out->accumulate.prev_out",
                "out->svgf.src",
                "out->ui.extent_ref"
            ],
            "properties": {
                "IPR factor": 50.0,
                "adaptivity": 0.9009900093078613,
                "adaptivity IPR factor": 3.0,
                "adaptivity percentile lower": 0.1902180016040802,
                "adaptivity percentile upper": 0.9065219759941101,
                "alpha": 0.9509999752044678,
                "depth threshold": 0.026403000578284264,
                "extended search": true,
                "filter mode": "stochastic bilinear",
                "firefly filter bias": 0.20000000298023224,
                "firefly filter enable": true,
                "firefly percentile lower": 0.25,
                "firefly percentile upper": 0.8999999761581421,
                "gbuffer check": "always",
                "hard clamp": "inf",
                "max history": "inf",
                "normal threshold": 0.645771861076355,
                "reuse border": true,
                "use motion vectors": true
            },
            "type": "Accumulate"
        },
        "add": {
            "enabled": true,
            "outputs": [
                "out->exposure.src"
            ],
            "properties": {
                "initial value": "",
                "number inputs": 2,
                "reduction": "accumulator + current_value"
            },
            "type": "Reduce"
        },
        "fxaa": {
            "enabled": true,
            "outputs": [
                "out->composite.input_0"
            ],
            "type": "FXAA"
        },
        "gbuffer": {
            "$+$outputs": [
                "emission->add.input_1",
                "gbuffer->accumulate.gbuffer",
                "gbuffer->svgf.gbuffer"
            ]
        },
        "render": {
            "$+$outputs": [
                "irradiance->accumulate.src"
            ],
            "properties": {
                "output": {
                    "demodulate albedo": true,
                    "emission on primary": false
                }
            }
        },
        "svgf": {
            "enabled": true,
            "outputs": [
                "out->add.input_0",
                "out->svgf.prev_out"
            ],
            "properties": {
                "iterations": 5,
                "overwrite format": "R16G16B16A16Sfloat",
                "filter": {
                    "depth": 40.0,
                    "luminance": 3.0,
                    "normals": 0.5235987901687622,
                    "type": "subsampled",
                    "kaleidoscope": false,
                    "kaleidoscope: shmem": true,
                    "z-bias depth": 0.0,
                    "z-bias normals": 3000.0
                },
                "variance estimate": {
                    "depth accept": 40.0,
                    "normal reject": 0.5235987901687622,
                    "spatial bias": 8.0,
                    "spatial falloff": 3.0
                },
                "taa": {
                    "alpha": 0.5,
                    "clamping": "min-max",
                    "debug": "none",
                    "enable motion vectors": true,
                    "filter": "none",
                    "mv sampling": "center"
                }
            },
            "type": "Denoiser (SVGF)"
        },
        "tonemap": {
            "outputs": [
                "out->fxaa.src"
            ]
        }
    }
}
