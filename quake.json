{
    "cli": {
        "--": {
            "pointer": "/nodes/quake/properties/startup commands"
        },
        "denoiser": {
            "default": "svgf",
            "type": "variant",
            "variants": {
                "dlss": {
                    "merge": "denoisers/dlss.json"
                },
                "svgf": {
                    "merge": "denoisers/svgf.json"
                }
            }
        },
        "renderer": {
            "variants": {
                "pt": {
                    "set": {
                        "/nodes/quake/properties/lights/selection": "grid",
                        "/nodes/render/properties/NEE candidates": 0,
                        "/nodes/render/properties/NEE grid candidates": 1,
                        "/nodes/render/properties/NEE probability": 0.8,
                        "/nodes/render/properties/emission on primary": false,
                        "/nodes/render/properties/max path length": 3,
                        "/nodes/render/properties/next event estimation": "mixture"
                    }
                },
                "pt_mcpg": {
                    "set": {
                        "/nodes/guiding/properties/lc/LC min pdf": 10,
                        "/nodes/guiding/properties/mc/guiding probability": 0.9,
                        "/nodes/guiding/properties/mc/width confidence z": 0,
                        "/nodes/quake/properties/lights/selection": "grid",
                        "/nodes/render/properties/NEE candidates": 0,
                        "/nodes/render/properties/NEE grid candidates": 1,
                        "/nodes/render/properties/NEE probability": 0.8,
                        "/nodes/render/properties/emission on primary": false,
                        "/nodes/render/properties/max path length": 3,
                        "/nodes/render/properties/next event estimation": "mixture"
                    }
                },
                "pt_ssmm": {
                    "set": {
                        "/nodes/quake/properties/lights/selection": "grid",
                        "/nodes/render/properties/NEE candidates": 0,
                        "/nodes/render/properties/NEE grid candidates": 1,
                        "/nodes/render/properties/NEE probability": 0.8,
                        "/nodes/render/properties/emission on primary": false,
                        "/nodes/render/properties/max path length": 3,
                        "/nodes/render/properties/next event estimation": "mixture"
                    }
                },
                "restir_di": {
                    "set": {
                        "/nodes/render/properties/emission on primary": false
                    }
                }
            }
        }
    },
    "graph_properties": {
        "flush thread pool": true,
        "fps limiter": false,
        "imgui event": "ui",
        "iterations in flight": 2,
        "time overwrite": "None"
    },
    "include": [
        "renderers.json"
    ],
    "nodes": {
        "add": {
            "enabled": true,
            "properties": {
                "initial value": "",
                "number inputs": 2,
                "reduction": "accumulator + current_value"
            },
            "type": "Reduce"
        },
        "blit": {
            "enabled": true,
            "outputs": [
                "acquire->imgui.acquire"
            ],
            "properties": {
                "blit mode": "FIT",
                "source array element": 0
            },
            "type": "Swapchain Blit"
        },
        "composite": {
            "enabled": true,
            "outputs": [
                "out->blit.src"
            ],
            "properties": {
                "initial value": "",
                "number inputs": 2,
                "reduction": "current_value + float4(accumulator.rgb, 1) * (1.0 - current_value.a)"
            },
            "type": "Reduce"
        },
        "exposure": {
            "enabled": true,
            "outputs": [
                "out->tonemap.src"
            ],
            "properties": {
                "ISO": 856.0,
                "K": 8.0,
                "aperature": 1.1200000047683716,
                "autoexposure": true,
                "max exposure": 10000.0,
                "max log luminance": 12.0,
                "metering": "center-weighted",
                "min exposure": 1.0,
                "min log luminance": -15.0,
                "q": 0.6499999761581421,
                "shutter time (ms)": 768.0,
                "speed down": 5.099999904632568,
                "speed up": 3.0999999046325684
            },
            "type": "Exposure"
        },
        "gbuffer": {
            "enabled": true,
            "outputs": [
                "emission->add.input_1",
                "gbuffer->render.gbuffer"
            ],
            "properties": {
                "0": true,
                "1": true,
                "2": true,
                "3": true,
                "4": true,
                "5": true,
                "6": false,
                "7": true,
                "emission format": "R16G16B16A16Sfloat",
                "height": 1080,
                "width": 1920
            },
            "type": "GBuffer (Raytraced)"
        },
        "imgui": {
            "enabled": true,
            "properties": {
                "imgui event": "ui"
            },
            "type": "ImGui"
        },
        "output": {
            "enabled": true,
            "outputs": [
                "acquire->blit.acquire",
                "controller->quake.controller",
                "window->imgui.window",
                "window->quake.window"
            ],
            "properties": {
                "acquire timeout": 100000000,
                "backend": "SDL3 (Video Subsystem)",
                "blit mode": "FIT",
                "mode": "fullscreen",
                "on_should_close_actions": {
                    "remove node": false,
                    "send sigint": false,
                    "send sigterm": true
                },
                "present mode": "Mailbox",
                "rebuild on recreate": false,
                "surface format": "R8G8B8A8Srgb, SrgbNonlinear"
            },
            "type": "Window"
        },
        "quake": {
            "enabled": true,
            "outputs": [
                "scene->gbuffer.scene",
                "scene->render.scene",
                "scene->ui.scene",
                "ui_draw_commands->ui.ui_draw_commands"
            ],
            "properties": {
                "command": "",
                "env": {
                    "Pitch": 0.0,
                    "Type": "Empty",
                    "Yaw": 0.0
                },
                "filtering": "nearest",
                "gamestate update": true,
                "overwrite mu_t/s": false,
                "overwrite sun": false,
                "rebuild after stop": true,
                "reproducible renders": false,
                "settings": {
                    "Alpha Test Threshold": 0.699999988079071,
                    "BLAS Rebuild Fraction": 0.33000001311302185,
                    "Clamp Normals": true,
                    "Pretransform Animated": false
                },
                "startup commands": "",
                "stop after worldspawn": -1,
                "volume max t": 1000.0
            },
            "type": "Quake"
        },
        "tonemap": {
            "enabled": true,
            "properties": {
                "alpha mode": "Perceptual luminance",
                "clamp output": true,
                "max white": 15.0,
                "perceptual exponent": 2.200000047683716,
                "tonemap": "Reinhard Extended"
            },
            "type": "Tonemap"
        },
        "ui": {
            "enabled": true,
            "outputs": [
                "out->composite.input_1"
            ],
            "type": "Quake UI"
        }
    },
    "version": 4
}
