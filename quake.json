{
    "cli": {
        "--": {
            "pointer": "/nodes/scene/properties/startup commands"
        }
    },
    "nodes": {
        "composite": {
            "enabled": true,
            "outputs": [
                "out->display.src"
            ],
            "properties": {
                "initial value": "",
                "number inputs": 2,
                "reduction": "current_value + float4(accumulator.rgb, 1) * (1.0 - current_value.a)"
            },
            "type": "Reduce"
        },
        "display": {
            "enabled": true,
            "type": "Swapchain Blit"
        },
        "exposure": {
            "enabled": true,
            "outputs": [
                "out->tonemap.src"
            ],
            "properties": {
                "iso": 856.0,
                "k": 2.963,
                "aperture": 1.1200000047683716,
                "autoexposure": true,
                "max exposure": 199.6,
                "max log luminance": 27.0,
                "metering": "center-weighted",
                "min exposure": 1.996e-08,
                "min log luminance": -9.353,
                "q": 0.6499999761581421,
                "shutter time": 768.0,
                "speed down": 5.099999904632568,
                "speed up": 3.0999999046325684
            },
            "type": "Exposure"
        },
        "gbuffer": {
            "enabled": true,
            "outputs": [
                "gbuffer->render.gbuffer"
            ],
            "properties": {
                "0": true,
                "1": true,
                "2": true,
                "3": true,
                "4": true,
                "5": true,
                "6": false,
                "7": false,
                "emission format": "R16G16B16A16Sfloat",
                "height": 1080,
                "width": 1920
            },
            "type": "GBuffer (Raytraced)"
        },
        "output": {
            "enabled": true,
            "outputs": [
                "canvas->display.canvas",
                "controller->scene.controller",
                "window->scene.window"
            ],
            "properties": {
                "acquire timeout": 100000000,
                "backend": "auto",
                "mode": "windowed",
                "on close": {
                    "remove node": false,
                    "send event": true
                },
                "present mode": "Mailbox",
                "rebuild on recreate": false,
                "surface format": "R8G8B8A8Srgb, SrgbNonlinear"
            },
            "type": "Window"
        },
        "scene": {
            "enabled": true,
            "outputs": [
                "scene->gbuffer.scene",
                "scene->render.scene",
                "scene->ui.scene",
                "ui_draw_commands->ui.ui_draw_commands"
            ],
            "properties": {
                "command": "",
                "env": {
                    "pitch": 0.0,
                    "type": "Empty",
                    "yaw": 0.0
                },
                "filtering": "nearest",
                "gamestate update": true,
                "overwrite mu_t/s": false,
                "overwrite sun": false,
                "rebuild after stop": true,
                "settings": {
                    "alpha test threshold": 0.699999988079071,
                    "blas rebuild fraction": 0.33000001311302185,
                    "clamp normals": true,
                    "pretransform animated": false
                },
                "startup commands": "",
                "stop after worldspawn": -1,
                "fog density factor": 1.7,
                "fog particle size": 2.7,
                "volume max t": 200.0
            },
            "type": "Quake"
        },
        "tonemap": {
            "enabled": true,
            "properties": {
                "alpha mode": "Perceptual luminance",
                "clamp output": true,
                "max white": 22.84,
                "perceptual exponent": 2.200000047683716,
                "tonemap": "Reinhard Extended"
            },
            "type": "Tonemap"
        },
        "ui": {
            "enabled": true,
            "outputs": [
                "out->composite.input_1"
            ],
            "type": "Quake UI"
        }
    },
    "version": 4,
    "presets": {
        "renderer": {
            "folder": "presets/renderer",
            "default": "pt_mcpg",
            "order": 0
        },
        "denoiser": {
            "folder": "presets/denoiser",
            "default": "svgf",
            "order": 1
        },
        "quality": {
            "folder": "presets/quality",
            "order": 2
        },
        "mixin": {
            "folder": "presets/mixin",
            "multiple": true,
            "order": 3
        }
    }
}
